# Merge into your existing HTTPS server block; keep its listen 443 / certificate settings.
# Set SOCKET_GROUP in the service script to the Nginx worker's group.
# The socket directory must allow that group to traverse it (mode 0750).
location / {
    proxy_pass http://unix:/dev/shm/volo/volo.sock:;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header scheme https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
}
# In WEB-INF/classes/local.properties set loginTrustedProxies=unix.
# Public URL in latke.properties remains https / your hostname / 443.
# Do not append no-store headers to static assets; see nginx-cache.conf.example.
