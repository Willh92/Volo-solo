# Merge these directives into the existing HTTPS server block.
# Remove panel/CDN/Nginx rules adding no-store/no-cache to /js/ and /scss/.
# Preserve the application's Cache-Control response header; do not hide or replace it globally.
# Existing TLS settings, security headers, proxy locations and access rules stay in place.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_types application/javascript text/javascript text/css application/json image/svg+xml;
